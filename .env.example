# PawClaim environment variables.
# Secrets come from environment variables / the secret manager — never commit real values.
# Copy to .env locally and fill in. Variables are added here as features need them.

# --- Database (Supabase Postgres) — packages/db ---
# App runtime: Supabase pooler connection string (transaction mode, port 6543).
DATABASE_URL=
# Prisma CLI (migrate/seed): direct or session-mode connection (port 5432). Migrations must not use the transaction pooler.
DIRECT_URL=
# Optional: shadow database for `pnpm db:migrate` (prisma migrate dev) if the DB user can't create databases.
SHADOW_DATABASE_URL=
